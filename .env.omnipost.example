# === OmniPost Configuration ===

# Database
DATABASE_URL=postgresql://omnipost:omnipost_secure_2026@postgres:5432/omnipost
POSTGRES_PASSWORD=omnipost_secure_2026

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# URLs
BACKEND_INTERNAL_URL=http://app:3000
NEXT_PUBLIC_BACKEND_URL=http://YOUR_DOMAIN:4200/api
FRONTEND_URL=http://YOUR_DOMAIN:4200

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/opt/omnipost/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/opt/omnipost/uploads

# Temporal
TEMPORAL_ADDRESS=temporal:7233

# OmniPost Tier (for self-hosted: start | standard | full)
OMNIPOST_TIER=full

# Playwright
PLAYWRIGHT_CONTEXTS_DIR=/data/browser-contexts
PLAYWRIGHT_HEALTH_URL=http://playwright:3500

# T-Pay Billing (SaaS mode)
TPAY_TERMINAL_KEY=
TPAY_PASSWORD=
TPAY_API_URL=https://securepay.tinkoff.ru/v2

# AI Content Generation
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Monitoring — Telegram Alerts
OMNIPOST_ALERT_BOT_TOKEN=
OMNIPOST_ALERT_CHAT_ID=

# Platform API Keys (from Postiz)
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# VK_APP_ID=
# VK_APP_SECRET=
